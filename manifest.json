{
  "manifest_version": 3,
  "name": "Startpage",
  "version": "1.0.0",
  "description": "New Tab page",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "startpage@localhost",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "bookmarks"]
}
